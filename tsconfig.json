{
    "$schema": "./node_modules/@effect/tsgo/schema.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "@effect/language-service",
                "includeSuggestionsInTsc": false,
                "diagnosticSeverity": {
                    "floatingEffect": "error",
                    "missingStarInYieldEffectGen": "error",
                    "missingReturnYieldStar": "error",
                    "promiseInEffectSuccess": "error",
                    "unsafeEffectTypeAssertion": "error",
                    "returnEffectInGen": "off",
                    "globalErrorInEffectCatch": "off",
                    "globalErrorInEffectFailure": "off",
                    "unknownInEffectCatch": "off",
                    "lazyPromiseInEffectSync": "error"
                }
            }
        ],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client"],
        "noEmit": true,
        "paths": {
            "@/*": ["./src/renderer/*"]
        }
    },
    "include": ["src", "services", "tests", "*.ts", "tools"]
}
