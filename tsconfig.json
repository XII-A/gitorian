{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node", "vite/client"],
        "noEmit": true,
        "paths": {
            "@/*": ["./src/renderer/*"]
        }
    },
    "include": ["src", "tests", "*.ts", "tools"]
}
